# Copy to .env and fill in. .env is git-ignored; this repo is public, so never commit real values.

APP_ENV=dev                 # dev | prod
SPEND_LEDGER=dev            # dev ($10 one-time cap) | live ($5/month cap)
LIVE_CAP_USD=5.00
DEV_CAP_USD=10.00

# Neon Postgres (pooled connection string)
DATABASE_URL=

# Image storage: Neon Object Storage (S3-compatible, path-style, private bucket)
STORAGE_BACKEND=s3          # s3 | local
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-2
STORAGE_BUCKET=mirror-images
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
LOCAL_DATA_DIR=./data       # local cache, and the store when STORAGE_BACKEND=local

# AI providers
FAL_KEY=
ANTHROPIC_API_KEY=
LLM=claude                  # claude | fake
LLM_TAG_MODEL=claude-haiku-5-5
LLM_OUTFIT_MODEL=claude-sonnet-5-5
BG_REMOVER=fal              # fal | fake
SEGMENTER=fal               # fal | fake
EMBEDDER=fashionclip        # fashionclip | fake
EMBEDDER_MODEL=hf-hub:Marqo/marqo-fashionCLIP   # open_clip name; needs `uv sync --extra ml`
FAL_INPUT_MODE=presign      # presign: fal fetches a short-lived link to the private bucket | data_uri: image sent inline
FAL_BG_ENDPOINT=fal-ai/birefnet/v2   # or bria/rmbg-3, pixelcut/background-removal, fal-ai/feynobg
FAL_BG_MODEL=General Use (Light)     # BiRefNet only
FAL_BG_RESOLUTION=1024x1024          # BiRefNet only; 2304x2304 needs "General Use (Dynamic)"
FAL_SEG_ENDPOINT=fal-ai/sam-3/image  # or fal-ai/sam-3-1/image
LLM_CHECKIN_MODEL=claude-haiku-5-5   # check-in vision call (garments, boxes, tags)
FACE_BLUR=off               # off: mirror photos are stored and sent to fal/Claude as taken | on: blurred copy is sent, original kept

# Mirror settings
TIMEZONE=
WEATHER_LAT=
WEATHER_LON=
TEMP_UNIT=F
PRECOMPUTE_TIME=06:00

# Calendars (secret iCal links; anyone holding one can read that calendar)
CAL_GOOGLE_ICS_URL=
CAL_OUTLOOK_ICS_URL=
CAL_ICLOUD_ICS_URL=

# Hardware
HARDWARE=mock               # mock | pi
