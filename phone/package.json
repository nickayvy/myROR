    "gen:taxonomy": "node scripts/gen-taxonomy.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.7",
    "@types/react": "18.3",
    "@types/react-dom": "18.3",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "5.7",
    "typescript-eslint": "^8.74.0",
    "vite": "^6.4.6"
  }
